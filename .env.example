# ---------------------------------------------------------------------
# BOOKING INQUIRIES — pick ONE option. Copy this file to .env.local.
# With neither set, the form still works but only logs to the server
# console: fine for local testing, NOT safe to launch with.
# ---------------------------------------------------------------------

# --- Option A: Web3Forms (fastest — no domain, no DNS) ---------------
# Get a key instantly at https://web3forms.com — enter your email, it
# mails you an access key. Free tier: 250 submissions/month.
# No branded auto-reply to the client on the free tier.
WEB3FORMS_ACCESS_KEY=

# --- Option B: Resend (branded, sends the client a confirmation) -----
# https://resend.com — free tier 3,000 emails/month. Needs a domain
# added and its DNS records set before you can send as your own address.
# If RESEND_API_KEY is set it takes priority over Web3Forms.
RESEND_API_KEY=
# Inbox that receives inquiries. Defaults to site.contact.email if unset.
INQUIRY_TO=
# Verified sender. Must be on a domain verified in Resend.
# For testing before verifying a domain: IBK Horbs <onboarding@resend.dev>
INQUIRY_FROM="IBK Horbs <hello@ibkhorbs.com>"
